		{
			"name": "5. Check Alice Initial Balance (0)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 200', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"var jsonData = pm.response.json();",
							"pm.test('Balance is 0', function() {",
							"    pm.expect(jsonData.balance).to.eql(0);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{aliceToken}}"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/wallets/{{aliceUserId}}",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"wallets",
						"{{aliceUserId}}"
					]
				}
			}
		},
