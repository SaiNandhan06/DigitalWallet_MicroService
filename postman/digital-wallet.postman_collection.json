{
	"info": {
		"_postman_id": "digital-wallet-e2e-collection",
		"name": "Digital Wallet System E2E Flow",
		"description": "Postman Collection for testing Digital Wallet microservices end-to-end.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080"
		},
		{
			"key": "aliceUserId",
			"value": ""
		},
		{
			"key": "bobUserId",
			"value": ""
		},
		{
			"key": "aliceToken",
			"value": ""
		},
		{
			"key": "bobToken",
			"value": ""
		}
	],
	"item": [
		{
			"name": "1. Signup Alice",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 201', function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"var jsonData = pm.response.json();",
							"pm.collectionVariables.set('aliceUserId', jsonData.id);",
							"console.log('Alice User ID saved: ' + jsonData.id);"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"name\": \"alice\",\n  \"email\": \"alice@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"USER\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/auth/signup",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"auth",
						"signup"
					]
				}
			}
		},
		{
			"name": "2. Signup Bob",
			"event": [
				{
					"listen": "test",
